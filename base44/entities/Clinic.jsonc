{
  "name": "Clinic",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Kliniknamn"
    },
    "org_number": {
      "type": "string",
      "title": "Organisationsnummer"
    },
    "email": {
      "type": "string",
      "title": "E-post"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "address": {
      "type": "string",
      "title": "Adress"
    },
    "industry": {
      "type": "string",
      "title": "Bransch"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.clinic_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.clinic_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}