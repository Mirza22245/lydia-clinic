{
  "name": "HygieneCheck",
  "type": "object",
  "properties": {
    "area": {
      "type": "string",
      "title": "Område"
    },
    "check_type": {
      "type": "string",
      "title": "Kontroll"
    },
    "frequency": {
      "type": "string",
      "title": "Frekvens"
    },
    "last_checked": {
      "type": "string",
      "title": "Senast kontrollerad"
    },
    "next_due": {
      "type": "string",
      "title": "Nästa kontroll"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "action_required",
        "failed"
      ],
      "title": "Resultat"
    },
    "responsible_person": {
      "type": "string",
      "title": "Ansvarig"
    },
    "notes": {
      "type": "string",
      "title": "Anteckningar"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administratör"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administratör"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administratör"
              }
            }
          ]
        }
      ]
    }
  }
}
