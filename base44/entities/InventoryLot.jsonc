{
  "name": "InventoryLot",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Produkt-ID"
    },
    "product_name": {
      "type": "string",
      "title": "Produkt"
    },
    "batch_number": {
      "type": "string",
      "title": "Batch/Lot"
    },
    "expires_at": {
      "type": "string",
      "title": "Utgångsdatum"
    },
    "quantity": {
      "type": "number",
      "title": "Antal"
    },
    "unit": {
      "type": "string",
      "title": "Enhet"
    },
    "cost": {
      "type": "number",
      "title": "Kostnad"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "expired",
        "depleted"
      ],
      "title": "Status"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administratör"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administratör"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administratör"
              }
            }
          ]
        }
      ]
    }
  }
}
