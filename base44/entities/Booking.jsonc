{
  "name": "Booking",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Kund-ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Kund"
    },
    "treatment_id": {
      "type": "string",
      "title": "Behandlings-ID"
    },
    "treatment_name": {
      "type": "string",
      "title": "Behandling"
    },
    "staff_name": {
      "type": "string",
      "title": "Behandlare"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "Slut"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "confirmed",
        "checked_in",
        "in_progress",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "pending",
      "title": "Status"
    },
    "price": {
      "type": "number",
      "title": "Pris (kr)"
    },
    "notes": {
      "type": "string",
      "title": "Anteckningar"
    },
    "room_id": {
      "type": "string",
      "title": "Rum"
    },
    "resource_ids": {
      "type": "string",
      "title": "Resurser (JSON)",
      "description": "JSON-array med Resource-ID:n som bokats f\u00f6r denna behandling"
    },
    "deposit_amount": {
      "type": "number",
      "default": 0,
      "title": "Deposition (kr)"
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false,
      "title": "Deposition betald"
    },
    "calendar_event_id": {
      "type": "string",
      "title": "Kalenderh\u00e4ndelse-ID",
      "description": "Google Calendar event-ID f\u00f6r synkronisering"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "customer_name",
    "treatment_name",
    "start_time"
  ],
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "delete": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    }
  }
}