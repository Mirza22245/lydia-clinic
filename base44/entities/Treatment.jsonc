{
  "name": "Treatment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Namn"
    },
    "description": {
      "type": "string",
      "title": "Beskrivning"
    },
    "duration": {
      "type": "number",
      "title": "L\u00e4ngd (min)"
    },
    "price": {
      "type": "number",
      "title": "Pris (kr)"
    },
    "category": {
      "type": "string",
      "title": "Kategori"
    },
    "vat": {
      "type": "number",
      "title": "Moms (%)",
      "default": 25
    },
    "treatment_type": {
      "type": "string",
      "enum": [
        "injektion",
        "filler",
        "botox",
        "kirurgi",
        "laser",
        "hud",
        "massage",
        "annan"
      ],
      "default": "annan",
      "title": "Behandlingstyp",
      "description": "Styra vilka IVO-regler som g\u00e4ller (injektion = 18+, bet\u00e4nketid, samtycke efter bet\u00e4nketid)"
    },
    "betanketid_hours": {
      "type": "number",
      "default": 0,
      "title": "Bet\u00e4nketid (timmar)",
      "description": "Laglig bet\u00e4nketid fr\u00e5n att patientinformationen l\u00e4mnas tills samtycke f\u00e5r signeras. 0 = ingen bet\u00e4nketid."
    },
    "information_version": {
      "type": "string",
      "title": "Informationsversion",
      "description": "Version av patientinformationen som l\u00e4mnas (t.ex. v1.0). Dokumenteras i compliance-posten."
    },
    "repeat_treatment_months": {
      "type": "number",
      "default": 0,
      "title": "Upprepningskontroll (m\u00e5nader)",
      "description": "F\u00f6r injektioner: kontrollera om samma behandling utf\u00f6rts inom detta antal m\u00e5nader (IVO: 6 m\u00e5n). 0 = ingen kontroll."
    },
    "requires_identity_verification": {
      "type": "boolean",
      "default": false,
      "title": "Kr\u00e4v identitetsverifiering",
      "description": "Kr\u00e4v verifierad identitet (t.ex. BankID) innan bokning/behandling"
    },
    "requires_ordination": {
      "type": "boolean",
      "default": false,
      "title": "Kr\u00e4v l\u00e4karordination",
      "description": "Kr\u00e4v individuell skriftlig l\u00e4karordination inf\u00f6r behandlingen (t.ex. botulinumtoxin)"
    },
    "requires_health_declaration": {
      "type": "boolean",
      "default": false,
      "title": "Kr\u00e4ver h\u00e4lsodeklaration"
    },
    "requires_consent": {
      "type": "boolean",
      "default": true,
      "title": "Kr\u00e4ver samtycke"
    },
    "requires_treatment_info": {
      "type": "boolean",
      "default": false,
      "title": "Kr\u00e4ver behandlingsinformation/risker"
    },
    "requires_aftercare": {
      "type": "boolean",
      "default": false,
      "title": "Kr\u00e4ver efterv\u00e5rdsinformation"
    },
    "requires_payment": {
      "type": "boolean",
      "default": false,
      "title": "Kr\u00e4ver betalning vid bokning"
    },
    "guest_booking_allowed": {
      "type": "boolean",
      "default": true,
      "title": "Till\u00e5t g\u00e4stbokning (utan konto)"
    },
    "min_age": {
      "type": "number",
      "default": 0,
      "title": "L\u00e4gsta \u00e5lder",
      "description": "0 = ingen \u00e5ldersgr\u00e4ns. F\u00f6r injektioner ignoreras detta och 18 anv\u00e4nds som minimum enligt IVO."
    },
    "waiting_period_days": {
      "type": "number",
      "default": 0,
      "title": "V\u00e4ntetid (dagar)",
      "description": "Antal dagar mellan bokning och tidigaste behandlingstillf\u00e4lle"
    },
    "cancellation_hours": {
      "type": "number",
      "default": 24,
      "title": "Avgiftsfri avbokning (timmar innan)"
    },
    "no_show_fee": {
      "type": "number",
      "default": 0,
      "title": "No-show-avgift (kr)"
    },
    "required_form_ids": {
      "type": "string",
      "title": "Obligatoriska formul\u00e4r (JSON)",
      "description": "JSON-array med FormTemplate-ID:n som kr\u00e4vs f\u00f6r denna behandling"
    },
    "buffer_before": {
      "type": "number",
      "default": 0,
      "title": "Buffert f\u00f6re (min)",
      "description": "F\u00f6rberedelsetid innan behandlingen som blockeras i schemat"
    },
    "buffer_after": {
      "type": "number",
      "default": 0,
      "title": "Buffert efter (min)",
      "description": "Uppklarningstid efter behandlingen som blockeras i schemat"
    },
    "min_lead_hours": {
      "type": "number",
      "default": 0,
      "title": "Minsta framf\u00f6rh\u00e5llning (timmar)",
      "description": "Tidigaste bokning = nu + min_lead_hours"
    },
    "max_lead_days": {
      "type": "number",
      "default": 0,
      "title": "Max bokningsframf\u00f6rh\u00e5llning (dagar)",
      "description": "0 = ingen gr\u00e4ns. Hur l\u00e5ngt fram kunden f\u00e5r boka"
    },
    "room_id": {
      "type": "string",
      "title": "Kr\u00e4ver rum",
      "description": "Valfritt rum-ID som m\u00e5ste vara ledigt f\u00f6r behandlingen"
    },
    "required_resource_ids": {
      "type": "string",
      "title": "Kr\u00e4ver resurser (JSON)",
      "description": "JSON-array med Resource-ID:n som m\u00e5ste vara tillg\u00e4ngliga"
    },
    "deposit_amount": {
      "type": "number",
      "default": 0,
      "title": "Deposition/f\u00f6rskott (kr)",
      "description": "Belopp som debiteras vid bokning; 0 = ingen deposition"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "delete": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    }
  }
}