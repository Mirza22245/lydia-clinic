{
  "name": "Treatment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Namn"
    },
    "description": {
      "type": "string",
      "title": "Beskrivning"
    },
    "duration": {
      "type": "number",
      "title": "L\u00e4ngd (min)"
    },
    "price": {
      "type": "number",
      "title": "Pris (kr)"
    },
    "category": {
      "type": "string",
      "title": "Kategori"
    },
    "vat": {
      "type": "number",
      "title": "Moms (%)",
      "default": 25
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "delete": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    }
  }
}