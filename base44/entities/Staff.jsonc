{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Namn"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "E-post"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "title": {
      "type": "string",
      "title": "Befattning"
    },
    "role": {
      "type": "string",
      "enum": [
        "administrat\u00f6r",
        "behandlare",
        "reception"
      ],
      "default": "behandlare",
      "title": "Roll"
    },
    "permissions": {
      "type": "string",
      "title": "Beh\u00f6righeter (JSON)",
      "description": "JSON-str\u00e4ng med explicita beh\u00f6righeter per omr\u00e5de"
    },
    "allowed_treatment_ids": {
      "type": "string",
      "title": "Behandlingar personen f\u00e5r utf\u00f6ra (JSON)",
      "description": "JSON-array med Treatment-ID:n. Tomt/saknas = alla behandlingar. Bokningssystemet nekar bokning av behandlingar som inte finns i listan."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Aktiv"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            }
          ]
        }
      ]
    }
  }
}