{
  "name": "FormSubmission",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "title": "Mall-ID"
    },
    "template_name": {
      "type": "string",
      "title": "Formul\u00e4r"
    },
    "template_version": {
      "type": "number",
      "title": "Mallversion",
      "default": 1,
      "description": "Vilken version av mallen som anv\u00e4ndes vid inl\u00e4mning. Gamla inl\u00e4mningar visar alltid den version kunden fyllde i."
    },
    "questions_snapshot": {
      "type": "string",
      "title": "Fr\u00e5gor vid inl\u00e4mning (JSON)",
      "description": "Of\u00f6r\u00e4nderlig kopia av fr\u00e5gorna exakt som de s\u00e5g ut vid inl\u00e4mningstillf\u00e4llet"
    },
    "customer_id": {
      "type": "string",
      "title": "Kund-ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Kund"
    },
    "booking_id": {
      "type": "string",
      "title": "Boknings-ID"
    },
    "answers": {
      "type": "string",
      "title": "Svar (JSON)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "submitted"
      ],
      "default": "submitted",
      "title": "Status"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Inl\u00e4mnat"
    },
    "submitted_by": {
      "type": "string",
      "title": "Inl\u00e4mnat av"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "template_name",
    "customer_name"
  ],
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "delete": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    }
  }
}