{
  "name": "WaitingList",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Kund-ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Kund"
    },
    "customer_email": {
      "type": "string",
      "format": "email",
      "title": "E-post"
    },
    "customer_phone": {
      "type": "string",
      "title": "Telefon"
    },
    "treatment_id": {
      "type": "string",
      "title": "Behandlings-ID"
    },
    "treatment_name": {
      "type": "string",
      "title": "Behandling"
    },
    "staff_name": {
      "type": "string",
      "title": "\u00d6nskad behandlare",
      "description": "Valfritt; tomt = ingen preferens"
    },
    "desired_from": {
      "type": "string",
      "format": "date",
      "title": "\u00d6nskad fr\u00e5n datum"
    },
    "desired_until": {
      "type": "string",
      "format": "date",
      "title": "\u00d6nskad till datum"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "offered",
        "booked",
        "expired",
        "cancelled"
      ],
      "default": "active",
      "title": "Status"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Erbjuden datum"
    },
    "note": {
      "type": "string",
      "title": "Anteckning"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "customer_name",
    "treatment_name"
  ],
  "rls": {
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "create": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "delete": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    }
  }
}