{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Kund-ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Kund"
    },
    "treatment_id": {
      "type": "string",
      "title": "Behandlings-ID"
    },
    "treatment_name": {
      "type": "string",
      "title": "Behandling"
    },
    "booking_id": {
      "type": "string",
      "title": "Boknings-ID"
    },
    "provider": {
      "type": "string",
      "title": "Behandlare"
    },
    "entry_date": {
      "type": "string",
      "format": "date-time",
      "title": "Datum"
    },
    "notes": {
      "type": "string",
      "title": "Anteckningar"
    },
    "observations": {
      "type": "string",
      "title": "Observationer"
    },
    "assessment": {
      "type": "string",
      "title": "Bed\u00f6mning"
    },
    "treatment_performed": {
      "type": "string",
      "title": "Utf\u00f6rd behandling"
    },
    "aftercare": {
      "type": "string",
      "title": "Efterv\u00e5rd"
    },
    "recommendations": {
      "type": "string",
      "title": "Rekommendationer"
    },
    "is_signed": {
      "type": "boolean",
      "default": false,
      "title": "Signerad"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Signerad datum"
    },
    "signed_by": {
      "type": "string",
      "title": "Signerad av"
    },
    "signature_hash": {
      "type": "string",
      "title": "Signaturhash",
      "description": "SHA-256-hash av signerat inneh\u00e5ll f\u00f6r integritetsverifiering"
    },
    "version": {
      "type": "number",
      "title": "Version",
      "default": 1
    },
    "parent_id": {
      "type": "string",
      "title": "Original-ID"
    },
    "clinic_id": {
      "type": "string",
      "title": "Klinik-ID"
    }
  },
  "required": [
    "customer_name",
    "entry_date"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "behandlare"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "behandlare"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "data.is_signed": {
            "$ne": true
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "behandlare"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "data.is_signed": {
            "$ne": true
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "administrat\u00f6r"
              }
            },
            {
              "user_condition": {
                "data.staff_role": "behandlare"
              }
            }
          ]
        }
      ]
    }
  }
}